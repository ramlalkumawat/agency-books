# AgencyBooks Environment Configuration Example
# -------------------------------------------------------------
# By default, AgencyBooks runs as an offline-first client application
# powered by IndexedDB (Local & Offline Data Persistence).
#
# If integrating with an optional remote backend (e.g. Supabase / Custom REST API),
# provide the non-secret public keys below.
# NEVER expose backend service-role or master keys in frontend code.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Optional Analytics & Reporting Endpoint
APP_ENV=production
APP_VERSION=1.0.0
